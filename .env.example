# =============================================================================
# Fash Studio — environment template (copy → .env.local / host env)
# Domain production: https://fashionstudio.pmai.space
# KHÔNG commit file .env / .env.local có secret thật.
# =============================================================================

# --- App / Auth base ---
# Public origin of this app (no trailing slash)
BETTER_AUTH_URL=https://fashionstudio.pmai.space
# Random secret ≥ 32 chars (openssl rand -hex 32)
BETTER_AUTH_SECRET=

# Client-visible: set "false" to disable sign-in (dev user only)
VITE_AUTH_ENABLED=true

# Optional public site URL (SEO / absolute links)
# SITE_URL=https://fashionstudio.pmai.space
# VITE_SITE_URL=https://fashionstudio.pmai.space

# Extra trusted origins (comma-separated), if you have more domains
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.fashionstudio.pmai.space

# --- Google OAuth (production trực tiếp — khuyến nghị self-host) ---
# Google Cloud Console → Credentials → OAuth client (Web)
# Authorized JavaScript origins:
#   https://fashionstudio.pmai.space
# Authorized redirect URIs:
#   https://fashionstudio.pmai.space/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Grok auth broker (preview / platform inject — tùy chọn) ---
# Preview sandbox dùng client baked-in; production cần client riêng (không dùng grok_preview)
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# --- AI content (tab "AI nội dung" trong studio) ---
# Bất kỳ API chuẩn OpenAI-compatible: Z.ai/GLM, Gemini (OpenAI-compat), OpenAI…
# Để trống AI_API_KEY → panel tự dùng template offline (không lỗi).
AI_API_KEY=
# Mặc định Z.ai open platform — đổi khi dùng nhà cung cấp khác, ví dụ:
#   Gemini OpenAI-compat: https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI:               https://api.openai.com/v1
AI_API_BASE=https://api.z.ai/api/paas/v4
# Tên model theo nhà cung cấp (Z.ai: glm-4.6 / glm-4.5-air; OpenAI: gpt-4o-mini…)
AI_MODEL=glm-4.6

# --- Database ---
# Production: Postgres (Neon / Supabase / Vercel Postgres)
# Preview sandbox: để trống → PGLite nhúng (mất data khi restart)
DATABASE_URL=

# Vercel (auto — thường không cần set tay)
# VERCEL_URL=
# VERCEL_PROJECT_PRODUCTION_URL=
